# Copy to .env and fill in. Get keys from https://build.nvidia.com (free).
#
# Every key is an independent rate-limit bucket - more keys means more headroom
# before anything has to fall back to a different model. Add as many as you have.
#
# Any of these forms work, and they can be mixed. Duplicates collapse.
#
#   NIM_API_KEY=nvapi-a                  a single key
#   NIM_API_KEYS=nvapi-a,nvapi-b         a list in one variable
#   NIM_API_KEYS_FILE=/run/secrets/nim   one per line, for docker secrets
#
# Check what's actually being picked up with:  make keys
#
NIM_API_KEY_1=nvapi-...
NIM_API_KEY_2=nvapi-...
# NIM_API_KEY_3=nvapi-...
# NIM_API_KEY_4=nvapi-...

# Optional. Bind address inside the container; compose maps it to 127.0.0.1.
FUSION_HOST=0.0.0.0
FUSION_PORT=8787

# DEBUG shows every routing decision and the signals behind it.
FUSION_LOG_LEVEL=INFO
